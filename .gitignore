# ============================================================
# Root .gitignore — Sem4 Project (Node + React/Vite + Python)
# ============================================================


# ───────────────────────────────────────────
# Environment & Secrets
# ───────────────────────────────────────────
.env
.env.*
!.env.example
*.local


# ───────────────────────────────────────────
# Node / npm / pnpm
# ───────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json
# Uncomment the line below if you use yarn or pnpm instead of npm:
# yarn.lock
# pnpm-lock.yaml


# ───────────────────────────────────────────
# Client (React / Vite)
# ───────────────────────────────────────────
client/node_modules/
client/dist/
client/dist-ssr/
client/.env
client/.env.*
!client/.env.example


# ───────────────────────────────────────────
# Server (Node.js)
# ───────────────────────────────────────────
server/node_modules/
server/.env
server/.env.*
!server/.env.example

# Log files generated by test scripts
server/*.log
server/output.txt
server/apps_output.txt
server/db_check_output.txt

# Uploaded files (runtime data, not source)
server/uploads/
uploads/


# ───────────────────────────────────────────
# Python / ML Engine
# ───────────────────────────────────────────

# Virtual environments
ml_engine/venv/
ml_engine/.venv/
venv/
.venv/
env/
ENV/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
ml_engine/dist/
ml_engine/build/
ml_engine/*.egg-info/
*.egg-info/
dist/
build/
*.egg

# Type checkers / linters
.pyre_configuration
.mypy_cache/
.pytype/
.ruff_cache/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebooks
.ipynb_checkpoints/

# Debug & output text files from ML engine
ml_engine/debug*.txt
ml_engine/out*.txt
ml_engine/out*.json
ml_engine/report*.txt
ml_engine/scores.json
ml_engine/test_output.txt

# Large dataset files (keep structure, ignore data)
ml_engine/datasets/
ml_engine/processed/


# ───────────────────────────────────────────
# Root-level test / scratch scripts
# ───────────────────────────────────────────
testNode.js
test_db.js
test_node_ai.js
update_fallback.js
update_feedback.js


# ───────────────────────────────────────────
# Editor & OS
# ───────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# ───────────────────────────────────────────
# Misc
# ───────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
